# Chave secreta para assinar o JWT — use uma string longa e aleatória em produção
SECRET_KEY=minha-chave-super-secreta-troque-em-producao
ALGORITHM=HS256

# Tempo de expiração do token em minutos (60 min = 1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL de conexão com o banco de dados
DATABASE_URL=sqlite:///./estoque.db